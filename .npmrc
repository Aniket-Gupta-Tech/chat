auto-install-peers=false
strict-peer-dependencies=false

# Download native binaries for all common developer platforms:
#   Linux   x64 / arm64   (servers, CI, Linux laptops, Replit)
#   macOS   x64 / arm64   (Intel and Apple Silicon Macs)
#   Windows x64 / arm64   (Windows laptops)
supportedArchitectures[os][]=linux
supportedArchitectures[os][]=darwin
supportedArchitectures[os][]=win32
supportedArchitectures[cpu][]=x64
supportedArchitectures[cpu][]=arm64

# Allow build scripts for native packages
onlyBuiltDependencies[]=esbuild
onlyBuiltDependencies[]=rollup
onlyBuiltDependencies[]=@rollup/rollup-darwin-arm64
onlyBuiltDependencies[]=@esbuild/darwin-arm64
